# Create a random key: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
API_KEY=replace_with_a_random_key
HOST=127.0.0.1
PORT=8787
SUNO_MCP_URL=https://api.suno.com/mcp
# Maximum multipart HTTP request size, including its file and form metadata.
MAX_UPLOAD_MB=32
# The generic /api/tools/:name/call endpoint ONLY; named REST routes are separately available.
ALLOWED_TOOLS=account-usage,audio-retrieve,library-list
# Refuse generation below this many credits. Leave empty to turn the check off.
MIN_CREDITS_REMAINING=
# Set to true to reject generation requests that have no idempotency_key.
REQUIRE_IDEMPOTENCY_KEY=false
