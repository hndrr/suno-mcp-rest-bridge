{
  "name": "suno-mcp-rest-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "auth": "node --env-file=.env --import=tsx src/auth.ts",
    "check:schema": "node --env-file=.env --import=tsx src/check-schema.ts",
    "dev": "node --env-file=.env --import=tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts",
    "test:upload-smoke": "node --experimental-strip-types --test test/upload-smoke.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "hono": "^4.10.0",
    "mcp-remote": "^0.14.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
